-- ──────────────────────────────────────────────
-- ESP
-- ──────────────────────────────────────────────
local function updateESP()
    -- mevcut highlight'ları temizle
    for pid, h in pairs(espHighlights) do
        local plr = Players:GetPlayerByUserId(pid)
        if not plr or not State.esp then
            h:Destroy()
            espHighlights[pid] = nil
        end
    end
    if not State.esp then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character then
            if not espHighlights[plr.UserId] then
                local h = Instance.new("Highlight")
                h.FillColor           = Color3.fromRGB(255, 50, 50)
                h.OutlineColor        = Color3.fromRGB(255, 255, 255)
                h.FillTransparency    = 0.65
                h.OutlineTransparency = 0
                h.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
                h.Adornee             = plr.Character
                h.Parent              = workspace
                espHighlights[plr.UserId] = h
            end
        end
    end
end

-- ──────────────────────────────────────────────
-- FLY
-- ──────────────────────────────────────────────
local FLY_SPEED = 60

local function enableFly()
    local hrp = getHRP()
    if not hrp then return end

    local bv = Instance.new("BodyVelocity")
    bv.Velocity        = Vector3.zero
    bv.MaxForce        = Vector3.new(1e5, 1e5, 1e5)
    bv.Parent          = hrp

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque       = Vector3.new(1e5, 1e5, 1e5)
    bg.D               = 50
    bg.Parent          = hrp

    flyBody = { bv = bv, bg = bg }

    local hum = getHum()
    if hum then hum.PlatformStand = true end
end

local function disableFly()
    if flyBody.bv then flyBody.bv:Destroy() end
    if flyBody.bg then flyBody.bg:Destroy() end
    flyBody = {}
    local hum = getHum()
    if hum then hum.PlatformStand = false end
end

-- ──────────────────────────────────────────────
-- AIMBOT — en yakın düşmanı ekran merkezine çek
-- ──────────────────────────────────────────────
local AIMBOT_FOV    = 200   -- piksel yarıçap
local AIMBOT_SMOOTH = 0.25  -- 0=anlık, 1=hiç hareket etmez

local function getNearestTarget()
    local center     = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best, bestDist = nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            if head then
                local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < AIMBOT_FOV and dist < bestDist then
                        bestDist = dist
                        best = head
                    end
                end
            end
        end
    end
    return best
end

-- ──────────────────────────────────────────────
-- KILL AURA
-- ──────────────────────────────────────────────
local KILL_RANGE = 20   -- studs

local function doKillAura()
    local hrp = getHRP()
    if not hrp then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character then
            local ehr = plr.Character:FindFirstChild("HumanoidRootPart")
            if ehr then
                local dist = (ehr.Position - hrp.Position).Magnitude
                if dist <= KILL_RANGE then
                    -- HRP'yi hedefe teleport et → touch damage tetikler
                    -- (bazı oyunlarda tool/remote gerekir; en evrensel yöntem budur)
                    local orig = hrp.CFrame
                    hrp.CFrame = ehr.CFrame
                    task.wait()
                    hrp.CFrame = orig
                end
            end
        end
    end
end

-- ──────────────────────────────────────────────
-- ANA DÖNGÜ
-- ──────────────────────────────────────────────
local prevFly = false

RunService.RenderStepped:Connect(function(dt)

    -- ESP güncelle (her 0.5s'de bir yeter ama burada hafif)
    updateESP()

    -- FLY
    if State.fly ~= prevFly then
        if State.fly then enableFly() else disableFly() end
        prevFly = State.fly
    end

    if State.fly and flyBody.bv and flyBody.bg then
        local cf   = Camera.CFrame
        local dir  = Vector3.zero

        if UserInput:IsKeyDown(Enum.KeyCode.W) then dir = dir + cf.LookVector end
        if UserInput:IsKeyDown(Enum.KeyCode.S) then dir = dir - cf.LookVector end
        if UserInput:IsKeyDown(Enum.KeyCode.A) then dir = dir - cf.RightVector end
        if UserInput:IsKeyDown(Enum.KeyCode.D) then dir = dir + cf.RightVector end
        if UserInput:IsKeyDown(Enum.KeyCode.Space) then
            dir = dir + Vector3.new(0, 1, 0)
        end
        if UserInput:IsKeyDown(Enum.KeyCode.LeftShift) then
            dir = dir - Vector3.new(0, 1, 0)
        end

        local mag = dir.Magnitude
        flyBody.bv.Velocity = (mag > 0) and (dir.Unit * FLY_SPEED) or Vector3.zero
        flyBody.bg.CFrame   = cf
    end

    -- NOCLIP
    if State.noclip then
        local c = getChar()
        if c then
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = false
                end
            end
        end
    end

    -- AIMBOT — sol tıklama basılıyken aktif
    if State.aimbot and UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = getNearestTarget()
        if target then
            local targetCF = CFrame.lookAt(Camera.CFrame.Position, target.Position)
            Camera.CFrame  = Camera.CFrame:Lerp(targetCF, AIMBOT_SMOOTH)
        end
    end

end)

-- Kill Aura stepped döngüsü
RunService.Stepped:Connect(function()
    if State.killaura then
        doKillAura()
    end
end)

